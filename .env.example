# Local SQLite development only. Docker Compose supplies PostgreSQL.
DATABASE_URL=sqlite:///./finagent.db
CHECKPOINT_URL=./checkpoints.db
WORKER_CONCURRENCY=3
WORKER_LEASE_SECONDS=60
# Real research requires timestamped verified input bundles. No fallback to synthetic.
REAL_DATA_PATH_CONTAINER=/data/real/bundle.json
REAL_DATA_PATH=
# Optional OpenAI-compatible structured persona model (never paste keys into chat).
LLM_API_KEY=
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=
LLM_CONCURRENCY=3
LLM_MIN_INTERVAL_SECONDS=0.2
# Identifying contact required by SEC public access policy.
SEC_USER_AGENT=
# Protect locally supplied benchmark imports.
BENCHMARK_IMPORT_TOKEN=

# Allowlisted SDK spans always export locally; Langfuse is optional and fail-open.
FINAGENT_TRACE_PATH=artifacts/traces/worker.jsonl
FINAGENT_LANGFUSE_ENABLED=false
LANGFUSE_BASE_URL=https://cloud.langfuse.com
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
